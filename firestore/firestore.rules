rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // orders collection — allow read/write for all clients on the same app
    // (no authentication required; suitable for trusted-network / internal use)
    // For a public deployment consider restricting access with Firebase Auth.
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
